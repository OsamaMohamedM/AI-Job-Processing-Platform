{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": { "Default": "" },
  "Jobs": { "MaxInputCharacters": 20000 },
  "Retry": {
    "MaxAttempts": 3,
    "BaseDelaySeconds": 2,
    "Multiplier": 2.0,
    "MaxDelaySeconds": 60,
    "JitterRatio": 0.2
  },
  "Outbox": {
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 50,
    "MaxPublishBackoffSeconds": 60
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "Exchange": "aijobs.exchange",
    "Queue": "aijobs.process",
    "RoutingKey": "job.process",
    "DeadLetterExchange": "aijobs.dlx",
    "DeadLetterQueue": "aijobs.process.dlq",
    "DeadLetterRoutingKey": "job.dead"
  },
  "Processing": {
    "LeaseSeconds": 120,
    "MaxConcurrentJobs": 4,
    "RequeueDelaySeconds": 5
  },
  "Ai": {
    "Provider": "Gemini",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "Model": "gemini-2.5-flash",
    "ApiKey": "",
    "TimeoutSeconds": 60
  }
}